# Copy this file to .env and fill in values from the provider consoles.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# DEMO IMAGES
# The original app images were stored in a Firebase Storage bucket that is no
# longer accessible without a paid plan. Keep this true to show public online
# forestry demo images in profiles, cards, details, tree-detection and NDVI
# views. To restore Firebase Storage images, set this to false and replace the
# stored Firebase image URLs with valid URLs from your own Storage bucket.
EXPO_PUBLIC_USE_DEMO_IMAGES=true
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_NEWS_API_KEY=
EXPO_PUBLIC_API_BASE_URL=
